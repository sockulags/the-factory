{
  "name": "@factory/desktop",
  "productName": "The Factory",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "The Factory desktop app",
  "author": "The Factory",
  "main": "dist/main.cjs",
  "scripts": {
    "build": "pnpm --filter @factory/ui build && node build.mjs",
    "dev": "pnpm run build && electron .",
    "package": "pnpm run build && electron-builder --publish never",
    "typecheck": "tsc --noEmit",
    "test": "vitest run test/unit",
    "test:e2e": "vitest run --config vitest.e2e.config.ts"
  },
  "devDependencies": {
    "@factory/protocol": "workspace:*",
    "@factory/ui": "workspace:*",
    "electron": "^44.5.1",
    "electron-builder": "^26.15.3",
    "electron-updater": "^6.8.9",
    "esbuild": "^0.25.11",
    "jose": "^6.1.0",
    "playwright": "^1.63.0"
  }
}
