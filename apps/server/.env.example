# Local development. Copy to apps/server/.env (loaded by `pnpm dev:server`).
PORT=8787
PUBLIC_URL=http://localhost:8787
DATABASE_URL=pglite:./data/db

# Either the dev Keycloak from deploy/docker-compose.dev.yml …
AUTH_MODE=oidc
OIDC_ISSUER=http://localhost:8080/realms/factory
OIDC_CLIENT_ID=factory-desktop
# … or a static token (no Keycloak needed):
# AUTH_MODE=dev
# DEV_TOKEN=let-me-in
