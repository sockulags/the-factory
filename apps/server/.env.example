# Local development. Copy to apps/server/.env (loaded by `pnpm dev:server`,
# which runs from apps/server — relative paths are relative to that folder).
PORT=8787
PUBLIC_URL=http://localhost:8787
DATABASE_URL=pglite:./data/db
WORKFLOWS_DIR=../../workflows
WORKTREES_DIR=./data/worktrees

# Simplest: a static token, no Keycloak. Type it on the app's sign-in screen.
AUTH_MODE=dev
DEV_TOKEN=let-me-in

# Or real OIDC against the dev Keycloak from deploy/docker-compose.dev.yml:
# AUTH_MODE=oidc
# OIDC_ISSUER=http://localhost:8080/realms/factory
# OIDC_CLIENT_ID=factory-desktop
