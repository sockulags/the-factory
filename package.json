{
  "name": "the-factory",
  "private": true,
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "pnpm -r run build",
    "typecheck": "pnpm -r run typecheck",
    "test": "pnpm -r run test",
    "lint": "biome check .",
    "format": "biome check --write .",
    "dev:server": "pnpm --filter @factory/server dev",
    "dev:ui": "pnpm --filter @factory/ui dev",
    "dev:desktop": "pnpm --filter @factory/desktop dev",
    "probe": "pnpm --filter @factory/runner probe",
    "chat": "pnpm --filter @factory/runner chat",
    "thread": "pnpm --filter @factory/core thread"
  },
  "devDependencies": {
    "@biomejs/biome": "2.2.4",
    "@types/node": "^22.18.0",
    "typescript": "~5.9.3",
    "vitest": "^3.2.4"
  }
}
