# URL team members type into the desktop app (reachable on the VPN).
PUBLIC_URL=https://factory.internal.example.com
POSTGRES_PASSWORD=change-me
# Keycloak realm URL and the public client for the desktop app.
OIDC_ISSUER=https://sso.example.com/realms/factory
OIDC_CLIENT_ID=factory-desktop
# Raise to force everyone onto a newer app version.
MIN_CLIENT_VERSION=0.0.0
# GitHub repo whose Releases feed the auto-updater, and a fine-grained token with
# read access to its contents (needed while the repo is private).
UPDATE_MIRROR_REPO=sockulags/the-factory
UPDATE_MIRROR_TOKEN=

# Plugin secrets, referenced by name from product integration settings.
GITHUB_TOKEN=
GITLAB_TOKEN=
